generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  role             Role              @default(SEKRETARIS_PAC)
  isActive         Boolean           @default(false)
  periodeAktifId   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastLogoutAt     DateTime?
  accounts         Account[]
  agendaKegiatan   AgendaKegiatan[]
  anggota          Anggota[]
  arsipSurats      ArsipSurat[]
  berkasPimpinans  BerkasPimpinan[]
  berkasSPs        BerkasSP[]
  logActivities    LogActivity[]
  pengajuanBerkass PengajuanBerkas[]
  periodes         Periode[]
  presensi         Presensi[]
  sessions         Session[]

  @@index([role, isActive, emailVerified])
  @@index([createdAt])
}

model Periode {
  id                String            @id @default(cuid())
  nama              String
  userId            String
  isActive          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  agendaKegiatan    AgendaKegiatan[]
  anggota           Anggota[]
  arsipSurats       ArsipSurat[]
  berkasPimpinans   BerkasPimpinan[]
  berkasSPs         BerkasSP[]
  logActivities     LogActivity[]
  pengajuanToPAC    PengajuanBerkas[] @relation("PengajuanToPAC")
  pengajuanToCabang PengajuanBerkas[] @relation("PengajuanToCabang")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  presensi          Presensi[]

  @@unique([nama, userId])
  @@index([userId])
}

model ArsipSurat {
  id               String      @id @default(cuid())
  userId           String
  periodeId        String
  noSurat          String
  jenisSurat       JenisSurat
  tanggal          DateTime
  pengirimPenerima String
  deskripsi        String?
  file             String?
  perihal          String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  organisasi       Organisasi?
  periode          Periode     @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodeId])
  @@index([tanggal])
  @@index([createdAt])
}

model BerkasSP {
  id              String     @id @default(cuid())
  userId          String
  periodeId       String
  nama            String
  tanggalMulai    DateTime
  tanggalBerakhir DateTime
  catatan         String?
  file            String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  organisasi      Organisasi
  periode         Periode    @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodeId])
}

model BerkasPimpinan {
  id        String   @id @default(cuid())
  userId    String
  periodeId String
  nama      String
  tanggal   DateTime
  catatan   String?
  file      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  periode   Periode  @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodeId])
}

model PengajuanBerkas {
  id              String          @id @default(cuid())
  userId          String
  periodeId       String
  periodeIdPac    String
  noSurat         String
  penerima        PenerimaSurat
  tanggal         DateTime
  keperluan       String
  deskripsi       String?
  file            String
  status          StatusPengajuan @default(PENDING)
  alasanPenolakan String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  periodePac      Periode         @relation("PengajuanToPAC", fields: [periodeIdPac], references: [id], onDelete: Cascade)
  periodeCabang   Periode         @relation("PengajuanToCabang", fields: [periodeId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([periodeId])
  @@index([periodeIdPac])
}

model Presensi {
  id            String         @id @default(cuid())
  userId        String
  periodeId     String
  namaKegiatan  String
  tempat        String
  penyelenggara String
  tanggal       DateTime
  jamMulai      String
  jamSelesai    String
  isActive      Boolean        @default(true)
  isForcedOpen  Boolean        @default(false)
  forcedOpenAt  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  periode       Periode        @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataPresensi  PresensiData[]

  @@index([userId, periodeId])
}

model PresensiData {
  id          String   @id @default(cuid())
  presensiId  String
  namaLengkap String
  email       String
  noHp        String
  emailHash   String
  noHpHash    String
  organisasi  String
  tingkat     String?
  jabatan     String?
  instansi    String?
  createdAt   DateTime @default(now())
  presensi    Presensi @relation(fields: [presensiId], references: [id], onDelete: Cascade)

  @@unique([presensiId, emailHash])
  @@unique([presensiId, noHpHash])
  @@index([presensiId])
}

model Anggota {
  id                     String       @id @default(cuid())
  userId                 String
  periodeId              String
  nik                    String?
  nia                    String?
  email                  String?
  foto                   String?
  namaLengkap            String
  tempatLahir            String?
  tanggalLahir           DateTime?
  jenisKelamin           JenisKelamin
  alamatLengkap          String?
  noHp                   String?
  hobi                   String?
  jabatan                String?
  noRfid                 String?
  pekerjaan              String?
  jenjangPendidikan      String?
  namaInstansiPendidikan String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  periode                Periode      @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user                   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendidikans            Pendidikan[]
  perkaderans            Perkaderan[]

  @@index([userId, periodeId])
}

model Pendidikan {
  id          String   @id @default(cuid())
  anggotaId   String
  jenjang     String
  namaSekolah String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  anggota     Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@index([anggotaId])
}

model Perkaderan {
  id             String   @id @default(cuid())
  anggotaId      String
  namaPerkaderan String
  tanggal        DateTime
  tempat         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  anggota        Anggota  @relation(fields: [anggotaId], references: [id], onDelete: Cascade)

  @@index([anggotaId])
}

model AgendaKegiatan {
  id             String    @id @default(cuid())
  userId         String
  periodeId      String
  judul          String
  deskripsi      String?
  lokasi         String?
  warna          String
  tanggalMulai   DateTime
  tanggalSelesai DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  periode        Periode   @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodeId])
  @@index([tanggalMulai])
}

model AllowedOrigin {
  id        String   @id @default(cuid())
  domain    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogActivity {
  id          String    @id @default(cuid())
  userId      String
  periodeId   String
  action      LogAction
  module      LogModule
  description String
  entityId    String?
  createdAt   DateTime  @default(now())
  browser     String?
  device      String?
  ipAddress   String?
  location    String?
  userAgent   String?
  periode     Periode   @relation(fields: [periodeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodeId, createdAt(sort: Desc)])
  @@index([module, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model LogEmail {
  id           String      @id @default(cuid())
  to           String
  subject      String
  type         EmailType
  status       EmailStatus @default(PENDING)
  errorMessage String?
  retryCount   Int         @default(0)
  metadata     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@index([to, createdAt(sort: Desc)])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
}

enum Role {
  SEKRETARIS_CABANG
  SEKRETARIS_PAC
}

enum JenisSurat {
  MASUK
  KELUAR
}

enum Organisasi {
  IPNU
  IPPNU
  BERSAMA
  CBP_KPP
}

enum StatusPengajuan {
  PENDING
  DITERIMA
  DITOLAK
}

enum PenerimaSurat {
  IPNU
  IPPNU
  BERSAMA
  CBP_KPP
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
  EXPORT
  APPROVE
  REJECT
  LOGIN
  LOGOUT
}

enum LogModule {
  ARSIP_SURAT
  ANGGOTA
  BERKAS_PIMPINAN
  BERKAS_SP
  AGENDA_KEGIATAN
  PENGAJUAN_BERKAS
  PERIODE
  USER
  AUTH
  PRESENSI
}

enum EmailType {
  VERIFICATION
  VERIFIED_SUCCESS
  PENGAJUAN_USER
  PENGAJUAN_ADMIN
  PENGAJUAN_STATUS
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}
