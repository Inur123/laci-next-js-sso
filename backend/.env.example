APP_ENV=development
HTTP_ADDR=:8080
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/laci
SSO_ISSUER=https://sso.example.org
SSO_CLIENT_ID=laci
SSO_CLIENT_SECRET=replace-me
SSO_REDIRECT_URL=http://localhost:3000/api/auth/oauth2/callback/sso-ipnu
SESSION_COOKIE_DOMAIN=
# Exact comma-separated native callback allowlist. This URI receives only a
# short-lived one-time code; the SSO provider callback remains SSO_REDIRECT_URL.
MOBILE_REDIRECT_URIS=lacidigital://oauth/callback
ENCRYPTION_KEY=change-me
API_KEY=
CRON_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Laci Digital
ADMIN_NOTIFICATION_EMAIL=
TRUSTED_PROXY_HEADERS=false
