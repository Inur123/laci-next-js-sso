# Salin file ini menjadi .env lalu ubah seluruh nilai sesuai environment.
# Nilai di file ini ikut dibundel ke APK/IPA: hanya isi konfigurasi publik,
# jangan pernah menaruh secret, token, password, atau API key.
APP_ENV=development
API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
MOBILE_REDIRECT_URI=lacidigital://oauth/callback
SSO_PROFILE_URL=https://pelajarnumagetan.id/dashboard/profil
